# Copy to .env.local and fill in.
# Google AI Studio key for the copilot (Gemini).
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: Postgres (Neon). Without it a local PGlite database is created in ./.pglite
DATABASE_URL=
# Optional: the copilot model chain, tried in order (default below)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
# Optional: protects POST /api/admin/seed in production (send as the x-admin-token header)
ADMIN_TOKEN=
